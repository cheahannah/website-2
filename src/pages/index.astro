---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
     <section>
        <Image
          src="/profile.png"
          alt="Profile photo"
          class="animate rounded-full block lg:mt-5 mt-0 lg:mb-5 mb-10 mx-auto sm:float-right sm:ml-5 sm:mb-5 lg:mr-5"
          width={200}
          height={200}
        />
    </section>
    <h1 class="animate font-bold text-black dark:text-white text-4xl">
      Hi! 
      <p>I'm Hannah Chea.</p>
    </h1>
    <div class="space-y-16">
      <section>
        <article class="space-y-6">
          <p class="animate">
             Based in San Francisco, CA, I am a proud eldest daughter of Chinese-Khmer refugees. My work lives at the intersection of culture and creativity — from the streets of Chinatown to the stories of the Khmer diaspora. 
          </p>
          <p class="animate">
            I'm here to document, celebrate, and share what makes our communities worth knowing.
          </p>
          <p class="animate">
            Check out my <Link href="https://beacons.ai/xirimpi/mediakit?origin=lib" aria-label="media kit" external>media kit</Link> here.
            <br>Or send any inquiries to <Link href="mailto:xirimpi@gmail.com" aria-label="xirimpi@gmail.com" external>xirimpi@gmail.com</Link>.
          </p>
        </article>

        <!-- Social Icons -->
        <div class="animate flex flex-wrap gap-3 mt-6">
          {socialIcons.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group size-8 flex items-center justify-center rounded-full"
            >
              <Icon
                name={social.icon}
                size={25}
                class="opacity-100 group-hover:opacity-55 transition-opacity duration-300"
              />
            </a>
          ))}
        </div>
      </section>

