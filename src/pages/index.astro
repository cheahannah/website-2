---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const iconMap: Record<string, string> = {
  instagram: "fa6-brands:instagram",
  tiktok:    "fa6-brands:tiktok",
  facebook:  "fa6-brands:facebook",
  youtube:   "fa6-brands:youtube",
  x:         "fa6-brands:x-twitter",
  linkedin:  "fa6-brands:linkedin-in",
  email:     "tabler:mail-filled",
};

const socialIcons = SOCIALS.map(social => ({
  href: social.HREF,
  icon: iconMap[social.NAME],
}));

