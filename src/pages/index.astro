---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { SITE, HOME } from "@consts";
import { Image } from "astro:assets";
import portrait from "../assets/hannah-chea-qipao.jpg";

// Outlets without a logo file render as a text wordmark.
const pressLogos: { name: string; logo?: string; height: string }[] = [
  { name: "CNBC Make It", logo: "/cnbc-make-it-logo.png", height: "h-4" },
  { name: "San Francisco Chronicle", logo: "/sf-chronicle-logo.png", height: "h-9" },
  { name: "SFGate", logo: "/sfgate-logo.png", height: "h-5" },
  { name: "ServusTV", logo: "/servustv-logo.png", height: "h-7" },
  { name: "Sing Tao Daily", logo: "/sing-tao-logo.svg", height: "h-7" },
  { name: "Infatuasian", logo: "/infatuasian-logo.png", height: "h-4" },
  { name: "Harper's Bazaar Vietnam", logo: "/bazaar-logo.png", height: "h-6" },
  { name: "The Free Press Journal", logo: "/fpj-logo.png", height: "h-5" },
  { name: "KTSF 26", logo: "/ktsf-logo.png", height: "h-5" },
  { name: "ABC7 News", logo: "/abc7-logo.png", height: "h-8" },
];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <section class="relative md:-mt-12 -mb-16">
    <!-- The 3:4 frame keeps the whole photo, down past the wrist and bracelet. -->
    <figure class="relative -mt-16 md:mt-0 md:absolute md:top-0 md:right-[max(0px,calc((100vw-48rem)/2-6rem))] md:w-[600px]">
      <Image
        src={portrait}
        alt="Hannah Chea in a red qipao, San Francisco lifestyle content creator and host"
        widths={[640, 960, 1400]}
        sizes="(min-width: 768px) 600px, 100vw"
        loading="eager"
        class="hero-photo animate block w-full aspect-[3/4] object-cover object-[45%_0%]"
      />
      <figcaption class="absolute bottom-1 right-5 md:right-2 text-[11px] leading-none tracking-wide opacity-60">
        Photo by Leo Gong
      </figcaption>
    </figure>

    <Container>
      <div class="relative space-y-6 -mt-12 pt-[67px] md:mt-0 md:pt-[90px] md:max-w-[52%] md:min-h-[800px]">
        <h1 class="animate font-semibold text-black dark:text-white text-5xl sm:text-6xl tracking-tight">
          Hannah Chea
        </h1>
        <p class="animate text-body">
          Living life & living history in San Francisco, California
        </p>
        <p class="animate text-body leading-relaxed">
          I make <a href="/work/" class="text-link">social media videos</a> recapping events, and experiences.
          I also sometimes <a href="/speaking-hosting/" class="text-link">host the events & experiences</a>.
        </p>
        <p class="animate text-body leading-relaxed">
          Check out my <a href={SITE.MEDIA_KIT} target="_blank" rel="noopener noreferrer" class="text-link">media kit</a>
          and reach out at <a href={`mailto:${SITE.EMAIL}`} class="text-link">{SITE.EMAIL}</a>
        </p>

        <div class="animate pt-6 space-y-4">
          <p class="eyebrow">As seen in</p>
          <a href="/press/" aria-label="See press features" class="group block">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-4">
              {pressLogos.map(outlet => (
                <li class="press-logo flex items-center">
                  {outlet.logo ? (
                    <img src={outlet.logo} alt={outlet.name} class={`${outlet.height} w-auto`} loading="lazy" />
                  ) : (
                    <span class="font-semibold text-base tracking-tight text-black dark:text-white">{outlet.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </a>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
