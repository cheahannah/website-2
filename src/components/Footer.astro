---
import Container from "@components/Container.astro";
import { Icon } from "astro-icon/components";
import { SITE, SOCIALS } from "@consts";

const iconMap: Record<string, string> = {
  instagram: "fa6-brands:instagram",
  tiktok:    "fa6-brands:tiktok",
  facebook:  "fa6-brands:facebook",
  youtube:   "fa6-brands:youtube",
  x:         "fa6-brands:x-twitter",
  linkedin:  "fa6-brands:linkedin-in",
  email:     "tabler:mail-filled",
};

// Spoken names for the icon-only links.
const labelMap: Record<string, string> = {
  instagram: "Instagram",
  tiktok:    "TikTok",
  facebook:  "Facebook",
  youtube:   "YouTube",
  x:         "X (Twitter)",
  linkedin:  "LinkedIn",
  email:     "Email",
};

const socialIcons = SOCIALS.map(social => ({
  href: social.HREF,
  icon: iconMap[social.NAME],
  label: labelMap[social.NAME],
}));
---



<footer class="animate">
  <Container>
    <div class="flex justify-between items-center">
      <div>
        &copy; 2026 {SITE.NAME}
      </div>
      <div class="flex flex-wrap gap-3 items-center">
        <!-- Social icons -->
        {socialIcons.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            target="_blank"
            rel="me noopener noreferrer"
            class="flex items-center justify-center rounded-full"
          >
            <Icon name={social.icon} size={20} class="opacity-85 hover:opacity-55  duration-300 ease-in-out" />
          </a>
        ))}

      </div>
    </div>
  </Container>
</footer>
