---
// Organization logo(s) as one-colour silhouettes, followed by the name.
type Props = {
  outlet: string;
  logo?: string | string[];
};

const { outlet, logo } = Astro.props;
const logos = logo ? [logo].flat() : [];
---

<div class="flex items-center gap-3 min-h-7">
  {logos.map((src) => (
    <span class="press-logo flex items-center">
      <img src={src} alt="" class="h-6 w-auto max-w-[110px] object-contain" loading="lazy" />
    </span>
  ))}
  <span class="eyebrow">{outlet}</span>
</div>
