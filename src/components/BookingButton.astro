---
import { SITE } from "@consts";

type Props = {
  subject: string;
}

const { subject } = Astro.props;
const href = `mailto:${SITE.EMAIL}?subject=${encodeURIComponent(subject)}`;
---

<a
  href={href}
  class="inline-block px-5 py-2.5 rounded-full text-base font-semibold bg-black text-white dark:bg-white dark:text-black hover:opacity-75 transition-opacity duration-300 ease-in-out"
>
  <slot />
</a>
