---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false} aria-label={`${SITE.NAME}, home`}>
        <div class="text-2xl opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
          🦐
        </div>
      </Link>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 text-lg sm:text-xl">
        <Link href="/about/" underline={false}>
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
            about
          </span>
        </Link>
        <Link href="/speaking-hosting/" underline={false}>
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
            speaking
          </span>
        </Link>
        <Link href="/work/" underline={false}>
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
            work
          </span>
        </Link>
        <Link href="/press/" underline={false}>
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
            press
          </span>
        </Link>
      </nav>
    </div>
  </Container>
</header>
