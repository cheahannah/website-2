---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false}>
        <div class="text-2xl opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
          {SITE.NAME} 🪷
        </div>
      </Link>
      <nav class="flex gap-4">
        <Link href="/portfolio" underline={false}>
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
          portfolio
          </span>
        </Link>
        <span>
        </span>
        <Link href="/press" underline={false} >
          <span class="opacity-100 hover:opacity-55 transition-opacity duration-300 ease-in-out">
            press
          </span>
        </Link>
      </nav>
    </div>
  </Container>
</header>
